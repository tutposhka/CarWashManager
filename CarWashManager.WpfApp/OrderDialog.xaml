<Window x:Class="CarWashManager.WpfApp.OrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tellimus"
        Height="420"
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,15">

            <TextBlock Text="Registreerimisnumber"
                       Margin="0,0,0,5"/>

            <TextBox x:Name="RegistrationTextBox"
                     Height="30"/>

        </StackPanel>

        <StackPanel Grid.Row="1"
                    Margin="0,0,0,15">

            <TextBlock Text="Sõiduki tüüp"
                       Margin="0,0,0,5"/>

            <ComboBox x:Name="VehicleTypeComboBox"
                      Height="30"/>

        </StackPanel>

        <StackPanel Grid.Row="2"
                    Margin="0,0,0,15">

            <TextBlock Text="Pesuprogramm"
                       Margin="0,0,0,5"/>

            <ComboBox x:Name="WashProgramComboBox"
                      Height="30"/>

        </StackPanel>

        <StackPanel Grid.Row="3"
                    Margin="0,0,0,15">

            <TextBlock Text="Staatus"
                       Margin="0,0,0,5"/>

            <ComboBox x:Name="StatusComboBox"
                      Height="30"/>

        </StackPanel>

        <TextBlock x:Name="ErrorTextBlock"
                   Grid.Row="4"
                   Margin="0,0,0,15"/>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Salvesta"
                    Width="100"
                    Height="35"
                    Margin="0,0,10,0"
                    Click="Save_Click"/>

            <Button Content="Tühista"
                    Width="100"
                    Height="35"
                    Click="Cancel_Click"/>

        </StackPanel>

    </Grid>
</Window>